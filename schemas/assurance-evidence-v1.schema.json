{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofPatch Assurance Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "evidence_id", "issuer", "target", "release_id", "proposal_id", "candidate_sha256", "policy_fingerprint", "manifest_sha256", "published_at", "expires_at", "facts"],
  "properties": {
    "schema": {"const": "proofpatch-assurance-v1"},
    "kind": {"enum": ["assurance_primary", "assurance_corroboration"]},
    "evidence_id": {"type": "string", "minLength": 8, "maxLength": 160},
    "issuer": {"type": "string", "minLength": 3, "maxLength": 160},
    "target": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "integer", "minimum": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "published_at": {"type": "integer"},
    "expires_at": {"type": "integer"},
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_readbacks", "canaries", "runtime_observations", "security_observations", "recovery"],
      "properties": {
        "state_readbacks": {"$ref": "#/$defs/comparisons"},
        "canaries": {"$ref": "#/$defs/comparisons"},
        "runtime_observations": {"$ref": "#/$defs/single_comparison"},
        "security_observations": {"$ref": "#/$defs/single_comparison"},
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release_id", "code_hex"],
          "properties": {
            "release_id": {"type": "string", "minLength": 1},
            "code_hex": {"type": "string", "minLength": 2, "pattern": "^[0-9a-fA-F]+$"}
          }
        }
      }
    }
  },
  "$defs": {
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expected", "observed"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "expected": {},
        "observed": {}
      }
    },
    "comparisons": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/comparison"}},
    "single_comparison": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/comparison"}}
  }
}
