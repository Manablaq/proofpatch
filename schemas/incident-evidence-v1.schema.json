{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofPatch Incident Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "evidence_id", "issuer", "target", "release_id", "installed_code_hash", "incident_type", "policy_fingerprint", "published_at", "expires_at", "facts"],
  "properties": {
    "schema": {"const": "proofpatch-incident-v1"},
    "kind": {"enum": ["incident_primary", "incident_corroboration"]},
    "evidence_id": {"type": "string", "minLength": 8, "maxLength": 160},
    "issuer": {"type": "string", "minLength": 3, "maxLength": 160},
    "target": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "installed_code_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "incident_type": {"type": "string", "minLength": 1},
    "policy_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "published_at": {"type": "integer"},
    "expires_at": {"type": "integer"},
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected_release", "reproduction", "continuation", "recovery"],
      "properties": {
        "affected_release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "release_id", "installed_code_hash", "incident_type"],
          "properties": {
            "target": {"type": "string", "minLength": 1},
            "release_id": {"type": "string", "minLength": 1},
            "installed_code_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "incident_type": {"type": "string", "minLength": 1}
          }
        },
        "reproduction": {"$ref": "#/$defs/single_comparison"},
        "continuation": {"$ref": "#/$defs/single_comparison"},
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release_id", "code_hex"],
          "properties": {
            "release_id": {"type": "string", "minLength": 1},
            "code_hex": {"type": "string", "minLength": 2, "pattern": "^[0-9a-fA-F]+$"}
          }
        }
      }
    }
  },
  "$defs": {
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expected", "observed"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "expected": {},
        "observed": {}
      }
    },
    "single_comparison": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/comparison"}}
  }
}
